---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BookingSection from '../components/sections/BookingSection.astro';
---
<BaseLayout
  title="Book Julian Perez — DJ & Producer | Booking Inquiries"
  description="Book Julian Perez for your event. Techno, House and Minimal DJ based in Spain, resident at Underground Ibiza. Performed in 50+ countries and 150 cities worldwide."
>
  <Header />
  <div style="padding-top: 120px;">
    <BookingSection />
  </div>
  <Footer alwaysVisible />
</BaseLayout>
