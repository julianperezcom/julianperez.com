<BaseLayout
  title="Julian Perez — Press & Media Coverage"
  description="Press coverage of Julian Perez: Resident Advisor, XLR8R, Mixmag, DJ Mag, Trommel Music, MEOKO, Vicious Magazine and more. Reviews, interviews and features from 2009 to present."
>
  <main style="max-width:800px;margin:0 auto;padding:4rem 2rem;font-family:sans-serif;line-height:1.8;color:#111;">
