---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="INTERFASE: The Infinite Set — Libro de Julian Perez / Book by Julian Perez"
  description="INTERFASE: The Infinite Set es el primer libro de Julián Pérez, DJ y productor español. Un ensayo narrativo sobre música, carrera, identidad y vida en la carretera. Disponible en inglés y español en Amazon. / The debut book by Spanish DJ and producer Julian Perez, available in English and Spanish."
  ogImage="/interfase-cover-en.png"
>
  <style>
    * { box-sizing: border-box; }

    .bp {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #111;
      background: #fff;
      line-height: 1.6;
    }

    /* NAV */
    .bp-nav {
      padding: 1rem 2rem;
      border-bottom: 1px solid #eee;
    }
    .bp-nav a {
      color: #888;
      text-decoration: none;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* HERO */
    .bp-hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 520px;
    }
    .bp-hero-img {
      position: relative;
      overflow: hidden;
      background: #0d1359;
    }
    .bp-hero-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left center;
      display: block;
    }
    .bp-hero-text {
      background: #0d1359;
      color: #fff;
      padding: 4rem 3.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .bp-hero-eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      margin-bottom: 1.5rem;
    }
    .bp-hero-title {
      font-size: clamp(2.4rem, 4vw, 3.6rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 0.95;
      margin: 0 0 0.4rem;
      color: #fff;
    }
    .bp-hero-sub {
      font-size: 1rem;
      color: rgba(255,255,255,0.55);
      font-style: italic;
      margin: 0 0 2rem;
    }
    .bp-hero-body {
      font-size: 0.9rem;
      line-height: 1.75;
      color: rgba(255,255,255,0.75);
      margin-bottom: 2.5rem;
    }
    .bp-hero-btns {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      max-width: 280px;
    }
    .btn-primary {
      display: block;
      text-align: center;
      background: #fff;
      color: #0d1359;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.85rem 1.5rem;
      border-radius: 2px;
    }
    .btn-secondary {
      display: block;
      text-align: center;
      background: transparent;
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.85rem 1.5rem;
      border-radius: 2px;
      border: 1px solid rgba(255,255,255,0.35);
    }

    /* TRIPTYCH */
    .bp-triptych {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      height: 380px;
    }
    .bp-triptych-panel {
      overflow: hidden;
    }
    .bp-triptych-panel img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s ease;
    }
    .bp-triptych-panel:hover img {
      transform: scale(1.03);
    }

    /* SECTION BASE */
    .bp-section {
      padding: 5rem 2rem;
    }
    .bp-section--gray {
      background: #f7f7f5;
    }
    .bp-section--dark {
      background: #111;
      color: #fff;
    }
    .bp-inner {
      max-width: 1100px;
      margin: 0 auto;
    }
    .bp-inner--narrow {
      max-width: 740px;
      margin: 0 auto;
    }

    /* EYEBROW */
    .bp-eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #bbb;
      margin-bottom: 2rem;
      display: block;
    }
    .bp-section--dark .bp-eyebrow {
      color: #555;
    }

    /* ABOUT GRID */
    .bp-about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
    .bp-about-title {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1;
      margin: 0 0 0.3rem;
    }
    .bp-about-subtitle {
      font-size: 0.95rem;
      color: #999;
      font-style: italic;
      margin: 0 0 1.75rem;
    }
    .bp-about-body p {
      font-size: 0.9rem;
      line-height: 1.85;
      color: #444;
      margin: 0 0 1rem;
    }
    .bp-divider {
      width: 1px;
      background: #e5e5e3;
    }

    /* FEATURE: image + text */
    .bp-feature {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      min-height: 460px;
    }
    .bp-feature--reverse {
      direction: rtl;
    }
    .bp-feature--reverse > * {
      direction: ltr;
    }
    .bp-feature-img {
      overflow: hidden;
    }
    .bp-feature-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .bp-feature-text {
      padding: 4rem 3.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: #f7f7f5;
    }
    .bp-feature-title {
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin: 0 0 0.3rem;
    }
    .bp-feature-sub {
      font-size: 0.9rem;
      color: #999;
      font-style: italic;
      margin: 0 0 1.75rem;
    }
    .bp-feature-body p {
      font-size: 0.88rem;
      line-height: 1.85;
      color: #555;
      margin: 0 0 0.9rem;
    }
    .bp-feature-body p:last-child { margin: 0; }

    /* QUOTES */
    .bp-quotes-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem 4rem;
    }
    .bp-quote {
      border-left: 2px solid #111;
      padding-left: 1.25rem;
    }
    .bp-quote p {
      font-size: 0.92rem;
      line-height: 1.85;
      font-style: italic;
      color: #333;
      margin: 0;
    }

    /* REVIEW */
    .bp-review-text {
      font-size: 1.3rem;
      line-height: 1.75;
      font-style: italic;
      color: #e8e8e4;
      margin: 0 0 1.5rem;
      font-weight: 300;
    }
    .bp-review-cite {
      font-size: 0.72rem;
      color: #555;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* EDITIONS */
    .bp-editions-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      max-width: 520px;
    }
    .bp-edition {
      border: 1px solid #e8e8e4;
      border-radius: 2px;
      padding: 2rem;
      text-align: center;
      background: #fff;
    }
    .bp-edition img {
      width: 80px;
      display: block;
      margin: 0 auto 1.25rem;
      border-radius: 1px;
    }
    .bp-edition-lang {
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #bbb;
      margin: 0 0 0.3rem;
    }
    .bp-edition-title {
      font-weight: 700;
      font-size: 0.88rem;
      line-height: 1.3;
      margin: 0 0 0.2rem;
    }
    .bp-edition-isbn {
      font-size: 0.7rem;
      color: #bbb;
      margin: 0 0 1.25rem;
    }
    .bp-edition a {
      display: block;
      background: #111;
      color: #fff;
      font-size: 0.66rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.6rem;
      border-radius: 1px;
    }

    /* AUTHOR */
    .bp-author-grid {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 4rem;
      align-items: start;
    }
    .bp-author-photo {
      width: 100%;
      display: block;
      border-radius: 2px;
    }
    .bp-author-name {
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin: 0 0 1.5rem;
    }
    .bp-author-body p {
      font-size: 0.9rem;
      line-height: 1.85;
      color: #555;
      margin: 0 0 1rem;
    }
    .bp-author-body a {
      font-size: 0.75rem;
      color: #999;
      text-decoration: none;
      border-bottom: 1px solid #ddd;
      padding-bottom: 2px;
      letter-spacing: 0.04em;
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      .bp-hero { grid-template-columns: 1fr; }
      .bp-hero-img { height: 280px; }
      .bp-hero-text { padding: 2.5rem 1.5rem; }
      .bp-triptych { height: 200px; }
      .bp-about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .bp-divider { display: none; }
      .bp-feature { grid-template-columns: 1fr; min-height: auto; }
      .bp-feature--reverse { direction: ltr; }
      .bp-feature-text { padding: 2.5rem 1.5rem; }
      .bp-quotes-grid { grid-template-columns: 1fr; gap: 2rem; }
      .bp-author-grid { grid-template-columns: 1fr; }
      .bp-author-photo { max-width: 180px; }
      .bp-section { padding: 3.5rem 1.5rem; }
    }
  </style>

  <div class="bp">

    <!-- NAV -->
    <nav class="bp-nav">
      <a href="/">← julianperez.com</a>
    </nav>

    <!-- HERO: portada + texto sobre fondo azul -->
    <section class="bp-hero">
      <div class="bp-hero-img">
        <img src="/interfase-cover-es.png" alt="INTERFASE — portada y contraportada" />
      </div>
      <div class="bp-hero-text">
        <span class="bp-hero-eyebrow">Julián Pérez · Primer libro · 2026</span>
        <h1 class="bp-hero-title">INTERFASE</h1>
        <p class="bp-hero-sub">The Infinite Set &nbsp;/&nbsp; La sesión infinita</p>
        <p class="bp-hero-body">¿Qué sucede cuando entregarse por completo no garantiza el éxito… pero sí te transforma? Un recorrido honesto, íntimo y —a veces— crudo por lo que ocurre cuando la pasión no acepta atajos ni garantías.</p>
        <div class="bp-hero-btns">
          <a href="https://www.amazon.com/dp/8409813726" target="_blank" rel="noopener" class="btn-primary">Buy in English — Amazon →</a>
          <a href="https://www.amazon.com/dp/8409794535" target="_blank" rel="noopener" class="btn-secondary">Comprar en español — Amazon →</a>
        </div>
      </div>
    </section>

    <!-- TRIPTYCH -->
    <div class="bp-triptych">
      <div class="bp-triptych-panel">
        <img src="/book/interfase-lifestyle-01.jpg" alt="INTERFASE — libro" loading="lazy" />
      </div>
      <div class="bp-triptych-panel">
        <img src="/book/interfase-interior.jpg" alt="INTERFASE — páginas interiores" loading="lazy" />
      </div>
      <div class="bp-triptych-panel">
        <img src="/book/interfase-author.jpg" alt="Julián Pérez" loading="lazy" />
      </div>
    </div>

    <!-- ABOUT BILINGUAL -->
    <section class="bp-section">
      <div class="bp-inner">
        <span class="bp-eyebrow">Sobre el libro · About the book</span>
        <div class="bp-about-grid">

          <div>
            <h2 class="bp-about-title">INTERFASE</h2>
            <p class="bp-about-subtitle">La sesión infinita</p>
            <div class="bp-about-body">
              <p>Hay etapas que no se pueden contar en orden. Lugares internos que no tienen nombre. Procesos que no siguen un patrón, pero dejan huella.</p>
              <p>Este libro no está escrito desde la certeza ni desde el éxito, sino desde el tránsito: ese espacio incómodo, fértil y necesario en el que uno ya no es quien era, pero todavía no sabe quién está empezando a ser.</p>
              <p>Desde los primeros pasos en la escena <em>underground</em> hasta festivales internacionales, Julián Pérez comparte lo que no se ve desde fuera: el desgaste silencioso, la fidelidad al instinto y la belleza de no llegar a ningún sitio, pero de seguir.</p>
            </div>
          </div>

          <div class="bp-divider"></div>

          <div>
            <h2 class="bp-about-title">INTERFASE</h2>
            <p class="bp-about-subtitle">The Infinite Set</p>
            <div class="bp-about-body">
              <p><em>INTERFASE</em> is not a success manual, nor a conventional autobiography. It is an honest, intimate — and at times raw — account of what happens when passion has no shortcuts and no guarantees.</p>
              <p>There are stages that cannot be told in order. Internal places without names. Processes that follow no pattern but leave a mark.</p>
              <p>From the first steps in the underground scene to international festivals, Julian Perez shares what is not visible from the outside: the silent exhaustion, the loyalty to instinct, and the strange beauty of not arriving anywhere, but continuing anyway.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- FEATURE 1: lifestyle foto + ES text -->
    <div class="bp-feature">
      <div class="bp-feature-img">
        <img src="/book/interfase-lifestyle-01.jpg" alt="INTERFASE" loading="lazy" />
      </div>
      <div class="bp-feature-text">
        <span class="bp-eyebrow" style="color:#999;">Música y vida</span>
        <h3 class="bp-feature-title">Un proceso, no una carrera</h3>
        <p class="bp-feature-sub">De la escena underground a los festivales internacionales</p>
        <div class="bp-feature-body">
          <p>Es un libro sobre música electrónica, sí, pero —sobre todo— sobre vida: sobre respetar los tiempos, albergar la duda, asumir los cambios, aprender a pausar… y, luego, volver a empezar.</p>
          <p>Desde cabinas en Berlín hasta escenarios en Tokio. Del ego al miedo, de los amigos que avanzan a los que se marchan. Sin mitificarlo. Sin fórmulas. Con verdades pequeñas, incómodas, siempre sinceras.</p>
        </div>
      </div>
    </div>

    <!-- FEATURE 2: EN text + interior foto -->
    <div class="bp-feature bp-feature--reverse">
      <div class="bp-feature-img">
        <img src="/book/interfase-interior.jpg" alt="INTERFASE interior pages" loading="lazy" />
      </div>
      <div class="bp-feature-text">
        <span class="bp-eyebrow" style="color:#999;">From the pages</span>
        <h3 class="bp-feature-title">Small truths, always sincere</h3>
        <p class="bp-feature-sub">A fragmented mirror for those still moving forward</p>
        <div class="bp-feature-body">
          <p>It is a book about music — but above all about life: about respecting timing, holding doubt, accepting change, and learning to pause.</p>
          <p>No heroic narrative. No formulas. Just authentic fragments that play while everything else stops. Uncomfortable, small truths that stay.</p>
        </div>
      </div>
    </div>

    <!-- QUOTES -->
    <section class="bp-section bp-section--gray">
      <div class="bp-inner--narrow">
        <span class="bp-eyebrow">Del libro · From the book</span>
        <div class="bp-quotes-grid">

          <div class="bp-quote">
            <p>"Cuando has sido DJ residente y llevas miles de mezclas encima, eso ya está dentro de ti. No lo fuerzas, no lo finges. Es instinto. Ahí es cuando entiendo a Senna. Cuando entras en ese estado en el que no piensas. Solo estás. Y todo fluye."</p>
          </div>

          <div class="bp-quote">
            <p>"Aprendí que no quiero llenar una sala si eso implica vaciarme yo. Ser fiel a lo que uno es no siempre da likes, ni contratos. Pero da paz."</p>
          </div>

          <div class="bp-quote">
            <p>"Nunca olvidaré un bolo en Barcelona en el que me pagaron con una cena. Esa noche aprendí más que en muchos otros eventos: cómo aguantar cuando nadie te mira."</p>
          </div>

          <div class="bp-quote">
            <p>"Es curioso: cuando dejas de correr detrás de algo, las cosas empiezan a aparecer solas. No porque el universo conspire, sino porque ya no proyectas esa desesperación."</p>
          </div>

        </div>
      </div>
    </section>

    <!-- EDITORIAL REVIEW -->
    <section class="bp-section bp-section--dark">
      <div class="bp-inner--narrow">
        <span class="bp-eyebrow">Valoración editorial</span>
        <p class="bp-review-text">"Una obra de enorme valor literario por su originalidad, su estilo directo y descarnado, sobrio y sin tapujos. Un magnífico libro armado de una voz propia con mucha fuerza expresiva y belleza poética que no solo nos atrapa por su narrativa concisa, sino que nos hace reflexionar sobre las complejidades de la vida creativa, el éxito y la necesidad de mirar hacia nuestro interior."</p>
        <span class="bp-review-cite">— Editorial Letra Minúscula · Informe de lectura, 2025</span>
      </div>
    </section>

    <!-- EDITIONS -->
    <section class="bp-section">
      <div class="bp-inner">
        <span class="bp-eyebrow">Ediciones · Editions</span>
        <div class="bp-editions-grid">

          <div class="bp-edition">
            <img src="/interfase-cover-en.png" alt="INTERFASE: The Infinite Set" />
            <p class="bp-edition-lang">English</p>
            <p class="bp-edition-title">The Infinite Set</p>
            <p class="bp-edition-isbn">ISBN 978-8409813728</p>
            <a href="https://www.amazon.com/dp/8409813726" target="_blank" rel="noopener">Amazon →</a>
          </div>

          <div class="bp-edition">
            <img src="/interfase-cover-es-sq.png" alt="INTERFASE: La sesión infinita" />
            <p class="bp-edition-lang">Español</p>
            <p class="bp-edition-title">La sesión infinita</p>
            <p class="bp-edition-isbn">ISBN 978-8409794539</p>
            <a href="https://www.amazon.com/dp/8409794535" target="_blank" rel="noopener">Amazon →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- AUTHOR -->
    <section class="bp-section bp-section--gray">
      <div class="bp-inner">
        <span class="bp-eyebrow">Sobre el autor · About the author</span>
        <div class="bp-author-grid">
          <img src="/book/interfase-author.jpg" alt="Julián Pérez" class="bp-author-photo" loading="lazy" />
          <div class="bp-author-body">
            <h3 class="bp-author-name">Julián Pérez</h3>
            <p>DJ y productor de música electrónica, nacido en Valencia en 1982. Afincado en Ibiza desde 2006, ha actuado en venues y festivales de Europa, Asia, América del Norte y América del Sur.</p>
            <p>Ha publicado música en Raum...musik, VIVa Music, Leftroom, 1Trax y sus propios sellos Fathers &amp; Sons Productions y Girada Unlimited. <em>INTERFASE</em> es su primer libro, disponible en inglés y en español.</p>
            <a href="/">← julianperez.com</a>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
