---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getReleases } from '../lib/sanity';

let releases: any[] = [];
try {
  releases = await getReleases();
} catch {
  releases = [];
}

const albums      = releases.filter((r: any) => r.releaseType === 'LP');
const eps         = releases.filter((r: any) => r.releaseType === 'EP');
const singles     = releases.filter((r: any) => r.releaseType === 'Single');
const remixes     = releases.filter((r: any) => r.releaseType === 'Remix');
const appearances = releases.filter((r: any) => r.releaseType === 'Appearance');

const releaseSchemas = releases
  .filter((r: any) => ['LP', 'EP', 'Single'].includes(r.releaseType))
  .map((r: any) => ({
    "@context": "https://schema.org",
    "@type": "MusicAlbum",
    "name": r.title,
    "byArtist": { "@type": "Person", "name": "Julian Perez", "url": "https://julianperez.com" },
    "datePublished": String(r.year),
    "recordLabel": r.label,
  }));
---
<BaseLayout
  title="Julian Perez — Discography | Albums, EPs & Singles"
  description="Full discography of Julian Perez. Albums: Solemnity (2016) and Break-Even (2021). Releases on Fathers & Sons Productions, Girada Unlimited, Cocoon Recordings, Raum..Musik, and Subwax Bcn."
>
  {releaseSchemas.map(schema => (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <Header />
  <main style="min-height:100vh; background:#0E0E0E; padding: 160px 52px 120px; max-width: 1000px; margin: 0 auto;">
    <div class="section-eyebrow" style="margin-bottom:12px;">Music</div>
    <h1 style="font-size:2.5rem; font-weight:700; color:#fff; margin-bottom:64px; line-height:1.1;">Discography</h1>

    {albums.length > 0 && (
      <section style="margin-bottom: 64px;">
        <h2 style="font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: #555; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #1a1a1a;">Albums</h2>
        <div class="discog-list">
          {albums.map((r: any) => (
            <div class="discog-list-row">
              <div class="discog-list-year">{r.year}</div>
              <div class="discog-list-title">{r.title}</div>
              <div class="discog-list-label">{r.label}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    {eps.length > 0 && (
      <section style="margin-bottom: 64px;">
        <h2 style="font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: #555; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #1a1a1a;">EPs</h2>
        <div class="discog-list">
          {eps.map((r: any) => (
            <div class="discog-list-row">
              <div class="discog-list-year">{r.year}</div>
              <div class="discog-list-title">{r.title}</div>
              <div class="discog-list-label">{r.label}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    {singles.length > 0 && (
      <section style="margin-bottom: 64px;">
        <h2 style="font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: #555; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #1a1a1a;">Singles</h2>
        <div class="discog-list">
          {singles.map((r: any) => (
            <div class="discog-list-row">
              <div class="discog-list-year">{r.year}</div>
              <div class="discog-list-title">{r.title}</div>
              <div class="discog-list-label">{r.label}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    {remixes.length > 0 && (
      <section style="margin-bottom: 64px;">
        <h2 style="font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: #555; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #1a1a1a;">Remixes</h2>
        <div class="discog-list">
          {remixes.map((r: any) => (
            <div class="discog-list-row">
              <div class="discog-list-year">{r.year}</div>
              <div class="discog-list-title">{r.title}</div>
              <div class="discog-list-label">{r.label}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    {appearances.length > 0 && (
      <section>
        <h2 style="font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: #555; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #1a1a1a;">Appearances</h2>
        <div class="discog-list">
          {appearances.map((r: any) => (
            <div class="discog-list-row">
              <div class="discog-list-year">{r.year}</div>
              <div class="discog-list-title">{r.title}</div>
              <div class="discog-list-label">{r.label}</div>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
