  <!-- Structured data — FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who is Julian Perez?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Julian Perez is a DJ and electronic music producer based in Spain with a summer residency at Underground Ibiza. He has been active since the early 1990s, playing House, Techno and Minimal. He is the founder of vinyl labels Fathers & Sons Productions (2012) and Girada Unlimited, has performed in over 50 countries and 150 cities, and released two studio albums: Solemnity (2016) and Break-Even (2021). In 2026 he published his debut book, INTERFASE: The Infinite Set."
        }
      },
      {
        "@type": "Question",
        "name": "What is Fathers & Sons Productions?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Fathers & Sons Productions is a vinyl-only record label founded by Julian Perez in 2012. Within its first year, the label hosted showcases in more than twelve countries. Every release has sold out within days of publication. The label released Julian's debut solo album Solemnity (2016) and was relaunched in 2023 with a new direction."
        }
      },
      {
        "@type": "Question",
        "name": "What is Girada Unlimited?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Girada Unlimited is a record label founded by Julian Perez that gained strong underground support before his involvement was widely known. Its tenth release was Julian's second album, Break-Even (2021). The label continues to evolve with releases by Julian and a carefully curated roster of artists."
        }
      },
      {
        "@type": "Question",
        "name": "Where does Julian Perez play in Ibiza?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Julian Perez holds a regular summer residency at Underground Ibiza, where he hosts his own nights each season. He has also appeared at landmark Ibiza events including ENTER. at Space and Cocoon Ibiza."
        }
      },
      {
        "@type": "Question",
        "name": "What festivals has Julian Perez played?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Julian Perez has appeared at Amsterdam Dance Event (ADE), Sunwaves Festival, Epizode Festival, The BPM Festival, Outline Festival, Sónar off week (Barcelona), Kazantip Festival, and Winter Music Conference, among others."
        }
      },
      {
        "@type": "Question",
        "name": "What clubs has Julian Perez played?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Julian Perez has performed at iconic clubs including Rex Club (Paris), Fabric (London), Womb (Tokyo), Robert Johnson (Frankfurt), and Underground (Ibiza), among many others across more than 50 countries."
        }
      },
      {
        "@type": "Question",
        "name": "What labels has Julian Perez released music on?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Julian Perez has released music on his own labels Fathers & Sons Productions and Girada Unlimited, as well as on respected labels including Cocoon Recordings, Raum..Musik, and Subwax Bcn."
        }
      }
    ]
  })} />

