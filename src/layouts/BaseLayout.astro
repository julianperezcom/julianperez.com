---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  articleMeta?: {
    publishedTime: string;
    imageAlt?: string;
    jsonLd: string;
  };
}
const {
  title = 'Julian Perez — DJ & Producer | Electronic Music',
  description = 'Julian Perez — DJ and producer based in Spain. Ibiza Underground resident. House, Techno and Minimal. Girada Unlimited & Fathers & Sons.',
  ogImage = '/og-image.jpg',
  ogType = 'website',
  articleMeta,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Julian Perez — DJ & Producer" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="es_ES" />
  <meta property="og:site_name" content="Julian Perez" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
  <meta name="twitter:creator" content="@julianperezcom" />

  <!-- Article meta (press pages only) -->
  {articleMeta && <>
    <meta property="article:published_time" content={articleMeta.publishedTime} />
    <meta property="article:author" content="Julian Perez" />
    <meta property="article:section" content="Press" />
    {articleMeta.imageAlt && <meta property="og:image:alt" content={articleMeta.imageAlt} />}
    <script type="application/ld+json" set:html={articleMeta.jsonLd} />
  </>}

  <!-- Structured data — Person -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Julian Perez",
    "alternateName": ["Julian Perez DJ", "Julián Pérez"],
    "url": "https://julianperez.com",
    "image": "https://julianperez.com/og-image.jpg",
    "description": "Julian Perez is a DJ and electronic music producer based in Spain, resident at Underground Ibiza. Active since the early 1990s in the House, Techno and Minimal scenes. Founder of vinyl labels Fathers & Sons Productions (2012) and Girada Unlimited. Has performed in over 50 countries and 150 cities, appeared at festivals including Amsterdam Dance Event, Sunwaves, Epizode, The BPM Festival and Outline Festival, and at clubs such as Rex Club (Paris), Fabric (London), Womb (Tokyo) and Robert Johnson (Frankfurt). Nominated Best Artist at Vicious Music Awards (2012, 2013) and Best Newcomer at DJ Awards (2016). Author of the book INTERFASE: The Infinite Set (2026).",
