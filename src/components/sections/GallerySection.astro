---
import { readdirSync } from 'fs';
import { join } from 'path';

function readGalleryDir(subfolder: string): string[] {
  try {
    const dir = join(process.cwd(), 'public', 'gallery', subfolder);
    return readdirSync(dir).filter(f => /\.(jpe?g|png|webp|gif)$/i.test(f));
  } catch { return []; }
}

const FLYERS = readGalleryDir('flyers');
const DMT = readGalleryDir('doingmything');
---

<!-- GALLERY -->
<div id="gallery">
  <div class="section-wrap" style="padding-bottom: 32px;">
    <div class="section-eyebrow" data-i18n="gallery.eyebrow">Gallery</div>
    <h2 class="section-title" data-i18n="gallery.title" style="color:#C8C7C3;">Photos</h2>
    <div class="music-tabs" style="margin-bottom:0;">
      <button class="tab-btn active" onclick="switchGallery('flyers', this)">Flyers</button>
      <button class="tab-btn" onclick="switchGallery('dmt', this)">Doing My Thing</button>
    </div>
  </div>

  <!-- FLYERS — populated by JS -->
  <div id="gallery-flyers" class="gallery-grid"></div>

  <!-- DOING MY THING — populated by JS -->
  <div id="gallery-dmt" class="gallery-grid" style="display:none;"></div>

  <div style="height: 96px;"></div>
</div>

<script define:vars={{ FLYERS, DMT }}>
  const GALLERY_BASE = 'gallery/';

  function buildGallery(container, files, subfolder) {
    const base = GALLERY_BASE + subfolder + '/';
    container.innerHTML = files.map(f =>
      `<div class="gallery-item"><img src="${base}${encodeURIComponent(f)}" loading="lazy" alt=""><div class="gallery-overlay"></div></div>`
    ).join('');
  }

  function shuffle(arr) {
    const a = [...arr]
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]]
    }
    return a
  }

  buildGallery(document.getElementById('gallery-flyers'), shuffle(FLYERS), 'flyers');
  buildGallery(document.getElementById('gallery-dmt'), shuffle(DMT), 'doingmything');

  function switchGallery(tab, btn) {
    document.querySelectorAll('#gallery .music-tabs .tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('gallery-flyers').style.display = tab === 'flyers' ? '' : 'none';
    document.getElementById('gallery-dmt').style.display = tab === 'dmt' ? '' : 'none';
  }
  (window as any).switchGallery = switchGallery
</script>
