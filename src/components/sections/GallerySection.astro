---
import manifest from '../../data/gallery-manifest.json';

function shuffle(arr: string[]): string[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const FLYERS = shuffle(manifest.flyers.filter(f => f.trim() !== ''));
const DMT = shuffle(manifest.doingmything.filter(f => f.trim() !== ''));
---

<!-- GALLERY -->
<div id="gallery">
  <div class="section-wrap" style="padding-bottom: 32px;">
    <div class="section-eyebrow" data-i18n="gallery.eyebrow">Gallery</div>
    <h2 class="section-title" data-i18n="gallery.title" style="color:#C8C7C3;">Photos</h2>
    <div class="music-tabs" style="margin-bottom:0;">
      <button class="tab-btn active" onclick="switchGallery('flyers', this)">Flyers</button>
      <button class="tab-btn" onclick="switchGallery('dmt', this)">Doing My Thing</button>
    </div>
  </div>

  <div id="gallery-flyers" class="gallery-grid">
    {FLYERS.map(f => (
      <div class="gallery-item">
        <img src={`/gallery/flyers/${encodeURIComponent(f)}`} alt="" />
        <div class="gallery-overlay"></div>
      </div>
    ))}
  </div>

  <div id="gallery-dmt" class="gallery-grid" style="display:none;">
    {DMT.map(f => (
      <div class="gallery-item">
        <img src={`/gallery/doingmything/${encodeURIComponent(f)}`} alt="" />
        <div class="gallery-overlay"></div>
      </div>
    ))}
  </div>

  <div style="height: 96px;"></div>
</div>

<script is:inline>
  function switchGallery(tab, btn) {
    document.querySelectorAll('#gallery .music-tabs .tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('gallery-flyers').style.display = tab === 'flyers' ? '' : 'none';
    document.getElementById('gallery-dmt').style.display = tab === 'dmt' ? '' : 'none';
  }
</script>
